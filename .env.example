# Public application identifiers
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=royaltydesk.example.testnet

# Server-only values. Use unique local secrets; never commit populated files.
ROYALTYDESK_DB_PATH=./data/royaltydesk.sqlite
ROYALTYDESK_FILES_PATH=./private
ROYALTYDESK_STORAGE_SECRET=replace-with-at-least-32-random-bytes
ROYALTYDESK_AUTH_ORIGIN=http://localhost:3000
ROYALTYDESK_WORKER_URL=http://127.0.0.1:3101
ROYALTYDESK_WORKER_TOKEN=replace-with-at-least-32-random-bytes
ROYALTYDESK_AGENT_KEYSTORE_PATH=./private/agent-keys
NEAR_RPC_URL=https://testnet-rpc.intea.rs
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=replace-with-supported-model
NEAR_AI_API_KEY=replace-with-api-key
STUDIO_MEDIA_PATH=./private/studio-media
STUDIO_CATALOGUE_DB_PATH=./private/studio-v2/phase05/studio.sqlite
STUDIO_BACKUP_PATH=./private/studio-backups
NEXT_PUBLIC_STUDIO_CONTRACT_ID=studio.example.testnet
STABILITY_API_KEY=replace-with-api-key
# Server-side ElevenLabs Music generation; never expose this key to the browser.
ELEVENLABS_API_KEY=replace-with-api-key
# Optional release evidence overrides
# RELEASE_SOURCE_REVISION=working-tree
# RELEASE_EVIDENCE_PATH=plans/evidence/artifacts/release-suite.json
# RELEASE_MANIFEST_PATH=plans/evidence/artifacts/release-manifest.json
