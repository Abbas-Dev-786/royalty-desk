{
  "name": "agent-music-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @studio/web",
    "dev:worker": "npm run dev --workspace @studio/worker",
    "check": "node scripts/require-install.mjs && npm run check --workspaces --if-present && node scripts/check-workspace.mjs",
    "check:offline": "node scripts/check-workspace.mjs && node --experimental-strip-types scripts/import-check.ts",
    "build": "node scripts/build.mjs",
    "build:offline": "node --experimental-strip-types scripts/import-check.ts",
    "test:studio-contract": "node scripts/run-contract.mjs test studio",
    "test:live": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/near-ai/probe.ts",
    "test:studio-domain": "node scripts/studio-suite.mjs domain",
    "test:studio-agents": "node scripts/studio-suite.mjs agents",
    "test:studio-media": "node scripts/studio-suite.mjs media",
    "test:studio-sandbox": "node scripts/sandbox/studio-journey.mjs",
    "test:studio-server": "node scripts/studio-suite.mjs server",
    "test:studio-e2e": "node scripts/studio-suite.mjs e2e",
    "verify:studio": "node scripts/verify-studio.mjs",
    "probe:studio-testnet": "node --env-file-if-exists=.env scripts/probe-studio-testnet.mjs",
    "test:studio-live-agent": "node --env-file-if-exists=.env --experimental-strip-types scripts/live/studio-creative.ts",
    "test:studio-live-collaboration": "node --env-file-if-exists=.env --experimental-strip-types scripts/live/studio-collaboration.ts",
    "test:studio-agent-keys": "node --experimental-strip-types scripts/sandbox/studio-agent-keys.mjs",
    "test:studio-journey": "node scripts/sandbox/studio-journey.mjs",
    "bootstrap:studio-testnet": "node --env-file-if-exists=.env scripts/live/studio-testnet-bootstrap.mjs",
    "test:studio-testnet": "node --env-file-if-exists=.env scripts/live/studio-testnet-journey.mjs",
    "check:studio-release": "node --env-file-if-exists=.env scripts/studio-release-readiness.mjs",
    "prepare:studio-catalogue": "node --env-file-if-exists=.env scripts/live/studio-prepare-catalogue.mjs",
    "commit:studio-catalogue": "node --env-file-if-exists=.env scripts/live/studio-commit-catalogue.mjs",
    "publish:studio-catalogue": "node --env-file-if-exists=.env scripts/live/studio-publish-catalogue.mjs",
    "test:studio-real-commerce": "node --env-file-if-exists=.env scripts/live/studio-real-commerce.mjs",
    "test:studio-real-payouts": "node --env-file-if-exists=.env scripts/live/studio-real-payouts.mjs",
    "audit:studio-ledger": "node --env-file-if-exists=.env scripts/live/studio-ledger-audit.mjs",
    "audit:studio-upgrade": "node --env-file-if-exists=.env scripts/live/studio-upgrade-audit.mjs",
    "test:studio-backup": "node --env-file-if-exists=.env scripts/live/studio-backup-drill.mjs",
    "inspect:studio-payout": "node --env-file-if-exists=.env scripts/live/studio-payout-incident.mjs",
    "inspect:studio-guest": "node --env-file-if-exists=.env scripts/live/studio-guest-recovery.mjs",
    "bootstrap:studio-reviewer": "node --env-file-if-exists=.env scripts/live/studio-reviewer-bootstrap.mjs",
    "bootstrap:studio-producer-create-key": "node --env-file-if-exists=.env scripts/live/studio-producer-create-key.mjs",
    "handover:studio-guardian": "node --env-file-if-exists=.env scripts/live/studio-guardian-handover.mjs",
    "bootstrap:studio-revenue-keys": "node --env-file-if-exists=.env scripts/live/studio-revenue-agent-keys.mjs",
    "inspect:studio-revenue": "node --env-file-if-exists=.env scripts/live/studio-revenue-status.mjs",
    "audit:studio-revenue": "node --env-file-if-exists=.env scripts/live/studio-revenue-audit.mjs",
    "check:studio-agent-readiness": "node --env-file-if-exists=.env scripts/live/studio-agent-readiness.mjs",
    "test:studio-live-music": "node --env-file-if-exists=.env --experimental-strip-types scripts/live/studio-elevenlabs-album.ts",
    "test:studio-live-stability": "node --env-file-if-exists=.env --experimental-strip-types scripts/live/studio-music.ts",
    "review:studio-phase03": "node --experimental-strip-types scripts/live/studio-phase03-review.ts",
    "probe:elevenlabs-music": "node --env-file-if-exists=.env --experimental-strip-types scripts/live/probe-elevenlabs-music.ts"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "better-sqlite3@12.11.1": true
  }
}
