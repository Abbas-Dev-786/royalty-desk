{
  "name": "accord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @studio/web",
    "dev:worker": "npm run dev --workspace @studio/worker",
    "build": "npm run build --workspace @studio/web && npm run build --workspace @studio/worker",
    "start:web": "npm run start --workspace @studio/web",
    "start:worker": "npm run start --workspace @studio/worker"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "better-sqlite3@12.11.1": true
  }
}
