{
  "name": "royaltydesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @royaltydesk/web",
    "dev:worker": "npm run dev --workspace @royaltydesk/worker",
    "check": "node scripts/require-install.mjs && npm run check --workspaces --if-present && node scripts/check-workspace.mjs",
    "check:offline": "node scripts/check-workspace.mjs && node --experimental-strip-types scripts/import-check.ts",
    "build": "node scripts/build.mjs",
    "build:offline": "node --experimental-strip-types scripts/import-check.ts",
    "test:domain": "node --experimental-strip-types --test packages/domain/tests/*.test.ts",
    "test:domain:core": "node --experimental-strip-types --test packages/domain/tests/money.test.ts packages/domain/tests/canonical.test.ts packages/domain/tests/schemas.test.ts packages/domain/tests/statement-normalization.test.ts packages/domain/tests/strict-parser.test.ts",
    "test:contract": "node scripts/run-contract.mjs test",
    "test:sandbox": "node scripts/test-sandbox.mjs",
    "test:fault-injection": "node scripts/test-fault-injection.mjs",
    "test:server": "node --experimental-strip-types --test packages/persistence/tests/*.test.ts apps/worker/tests/*.test.ts",
    "test:agents": "node scripts/test-agents.mjs",
    "test:recovery": "node --experimental-strip-types scripts/test-recovery.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:live": "node --env-file-if-exists=.env --experimental-strip-types apps/worker/src/near-ai/probe.ts",
    "verify:release": "node scripts/not-implemented.mjs verify:release"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
